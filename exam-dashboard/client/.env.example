# For local development (defaults to http://localhost:5000)
# REACT_APP_SOCKET_URL=http://localhost:5000
# REACT_APP_API_URL=http://localhost:5000

# For production deployment (e.g. Render / Railway / Heroku backend URL):
# NOTE: React environment variables are embedded into the static bundle during `npm run build`.
# You MUST set these environment variables in your deployment settings (e.g. Vercel/Netlify dashboard) BEFORE building the client.
REACT_APP_SOCKET_URL=https://your-backend-url.onrender.com
REACT_APP_API_URL=https://your-backend-url.onrender.com

